<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inspection_robot_s200_sim">
  <xacro:property name="mesh_dir" value="package://inspection_robot_description/meshes/S200_4wd_robot_meshes"/>
  <xacro:property name="wheel_radius" value="0.100"/>
  <xacro:property name="wheel_width" value="0.060"/>

  <material name="wheeltec_blue"><color rgba="0.74118 0.90196 0.95686 1"/></material>
  <material name="wheeltec_dark"><color rgba="0.37647 0.37647 0.37647 1"/></material>
  <material name="wheeltec_white"><color rgba="1 1 1 1"/></material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
               izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3*radius*radius + width*width) / 12.0}" ixy="0" ixz="0"
               iyy="${mass * radius*radius / 2.0}" iyz="0"
               izz="${mass * (3*radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>
  <link name="base_link">
    <xacro:box_inertial mass="38.0" x="0.48" y="0.46" z="0.12"/>
    <visual><geometry><mesh filename="${mesh_dir}/base_link.STL"/></geometry><material name="wheeltec_blue"/></visual>
    <!-- Keep the horizontal chassis collision envelope while placing its top
         below the lidar scan plane. A tall solid box would make the simulated
         lidar detect its own chassis, unlike the real sensor installation. -->
    <collision><origin xyz="0.005 0 0.0"/><geometry><box size="0.48 0.46 0.04"/></geometry></collision>
  </link>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.078"/>
  </joint>

  <xacro:macro name="s200_wheel" params="name x y material">
    <link name="${name}_wheel_link">
      <xacro:wheel_inertial mass="2.0" radius="${wheel_radius}" width="${wheel_width}"/>
      <visual><geometry><mesh filename="${mesh_dir}/${name}_wheel_link.STL"/></geometry><material name="${material}"/></visual>
      <collision><origin rpy="1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/><origin xyz="${x} ${y} 0.037"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0.0"/>
    </joint>
    <gazebo reference="${name}_wheel_link">
      <!-- Preserve longitudinal grip while allowing the lateral tire slip
           required by a four-wheel skid-steer chassis during turns. -->
      <mu1>1.0</mu1>
      <mu2>0.05</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000</kp>
      <kd>10</kd>
    </gazebo>
  </xacro:macro>
  <xacro:s200_wheel name="lf" x="0.176" y="0.2942" material="wheeltec_dark"/>
  <xacro:s200_wheel name="lb" x="-0.176" y="0.2942" material="wheeltec_dark"/>
  <xacro:s200_wheel name="rb" x="-0.176" y="-0.2942" material="wheeltec_dark"/>
  <xacro:s200_wheel name="rf" x="0.176" y="-0.2942" material="wheeltec_white"/>

  <link name="controller_link"><visual><geometry><mesh filename="${mesh_dir}/controller_link.STL"/></geometry><material name="wheeltec_blue"/></visual></link>
  <joint name="controller_joint" type="fixed"><parent link="base_link"/><child link="controller_link"/><origin xyz="-0.015598 0.033015 0.16714"/></joint>
  <link name="mushroom_link"><visual><geometry><mesh filename="${mesh_dir}/mushroom_link.STL"/></geometry><material name="wheeltec_blue"/></visual></link>
  <joint name="mushroom_joint" type="fixed"><parent link="base_link"/><child link="mushroom_link"/><origin xyz="-0.07094 0 0.45681"/></joint>
  <link name="gyro_link"/>
  <joint name="base_to_gyro" type="fixed"><parent link="base_link"/><child link="gyro_link"/></joint>

  <link name="laser_link"><visual><geometry><mesh filename="${mesh_dir}/laser_link.STL"/></geometry><material name="wheeltec_white"/></visual></link>
  <joint name="base_to_laser" type="fixed"><parent link="base_footprint"/><child link="laser_link"/><origin xyz="0.08874 0.00067 0.11102"/></joint>
  <gazebo reference="laser_link">
    <sensor name="laser" type="ray">
      <always_on>true</always_on><visualize>false</visualize><update_rate>12</update_rate>
      <ray>
        <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
      </ray>
      <plugin name="laser_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type><frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="camera_link"><visual><geometry><mesh filename="${mesh_dir}/camera_link.STL"/></geometry><material name="wheeltec_white"/></visual></link>
  <joint name="base_to_camera" type="fixed"><parent link="base_footprint"/><child link="camera_link"/><origin xyz="0.16578 0.00095 0.1682"/></joint>

  <xacro:macro name="ultra" params="name topic y yaw">
    <link name="${name}"/>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/><origin xyz="0.20 ${y} 0.03" rpy="0 0 ${yaw}"/>
    </joint>
    <!-- gazebo_ros (Humble) does not ship a Range sensor plugin, so each
         ultrasonic is modelled as a one-sample LaserScan published to
         /ultrasonic/scan/<key>. ultrasonic_range_bridge.py republishes it as
         sensor_msgs/Range on /ultrasonic/<key>, the topic the safety node and
         the real base driver both use. -->
    <gazebo reference="${name}">
      <sensor name="${name}_sensor" type="ray">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.26</min_angle>
              <max_angle>0.26</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>5.3</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="${name}_ray_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=${topic}</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${name}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:ultra name="ultrasonic_a_link" topic="/ultrasonic/scan/a" y="0.14" yaw="0.35"/>
  <xacro:ultra name="ultrasonic_b_link" topic="/ultrasonic/scan/b" y="0.05" yaw="0.10"/>
  <xacro:ultra name="ultrasonic_c_link" topic="/ultrasonic/scan/c" y="-0.05" yaw="-0.10"/>
  <xacro:ultra name="ultrasonic_d_link" topic="/ultrasonic/scan/d" y="-0.14" yaw="-0.35"/>
  <xacro:ultra name="ultrasonic_e_link" topic="/ultrasonic/scan/e" y="0.0" yaw="3.14159"/>
  <xacro:ultra name="ultrasonic_f_link" topic="/ultrasonic/scan/f" y="0.0" yaw="0.0"/>

  <gazebo>
    <plugin name="s200_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=/simulation/cmd_vel</remapping><remapping>odom:=/odometry/filtered</remapping></ros>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>lf_wheel_joint</left_joint><right_joint>rf_wheel_joint</right_joint>
      <left_joint>lb_wheel_joint</left_joint><right_joint>rb_wheel_joint</right_joint>
      <wheel_separation>0.5884</wheel_separation><wheel_separation>0.5884</wheel_separation>
      <wheel_diameter>0.200</wheel_diameter><wheel_diameter>0.200</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque><max_wheel_acceleration>2.5</max_wheel_acceleration>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
